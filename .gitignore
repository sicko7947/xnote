# Local builds and macOS files
/dist/
# Binary from `go build ./cmd/xnote/main.go`; a root-level `main` file also
# shadows the `main` branch for git revision resolution.
/main
.DS_Store
*.test
coverage.out

# Local application signing profile; only the empty example is versioned.
/internal/xnote/app_profile.json

# Credentials and private runtime data
.env
.env.*
!.env.example
/config.json
/data/
/recordings/
/.work/
*.log
*.mp3
*.wav
*.m4a
*.partial

# Do not reintroduce reverse-engineering artifacts or the retired prototype.
*.apk
*.xapk
/.venv/
/research/
/doway_extracted/
__pycache__/
*.pyc

# Local-only APK, extraction and disassembly references
/artifacts/

# Share website tooling and local secrets
/web/node_modules/
/web/.wrangler/
/web/.dev.vars
/web/.dev.vars.*
