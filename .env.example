# Copy to ~/Documents/XNote/.env and chmod 600 that file.
# Shell environment overrides this file. Values are literal, never executed.
# Codex uses the independently authenticated local proxy at 127.0.0.1:8377.
ELEVENLABS_API_KEY=
# Optional OpenAI-compatible API provider:
XNOTE_API_KEY=
# Private token for your Cloudflare share site. `cd web && bun run setup` creates it.
XNOTE_SHARE_TOKEN=
